PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://auth_user:CHANGE_ME@localhost:5432/breezy_auth

# JWT
JWT_SECRET=CHANGE_ME_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Bcrypt
BCRYPT_ROUNDS=12

# Communication interne entre services (même valeur dans tous les services)
INTERNAL_SECRET=CHANGE_ME_valeur_longue_et_aleatoire

# URL du user-service (en local ou via Docker)
USER_SERVICE_URL=http://localhost:3002
